.DS_Store
__pycache__/
*.pyc

# Build inputs: large, regenerated by the R3000 pipeline, not source.
pipeline/*.json
pipeline/commentary.html

# Generated by make_r3k_dash.py; the served copy lives in docs/.
pipeline/r3k_dashboard.html
pipeline/*.bak

# The contact list holds real names, so it stays local. The generated pages
# under docs/r/ MUST be committed or Cloudflare never receives them and every
# tracked link 404s. They contain only the slug, no names.
contacts.txt

# 471 tiny per-company address files, regenerable and noisy in diffs.
pipeline/addresses/

# ...but the state file is the baseline the checks compare against, and is
# small enough to keep as a record of what was last published.
!pipeline/refresh_state.json
